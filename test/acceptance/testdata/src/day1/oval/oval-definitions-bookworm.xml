        <title>CVE-1999-0199 glibc</title>
        <affected family="unix">
          <platform>Debian GNU/Linux 12</platform>
          <product>glibc</product>
        </affected>
        <reference source="CVE" ref_id="CVE-1999-0199" ref_url="https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-1999-0199"/>
